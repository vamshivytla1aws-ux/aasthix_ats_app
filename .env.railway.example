# Core app
NODE_ENV=production
APP_PUBLIC_URL=https://app.aasthix.com
JWT_SECRET=replace-with-a-long-random-secret
ALLOW_OPEN_SIGNUP=false

# Database / cache
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_SSL=true
REDIS_URL=${{Redis.REDIS_URL}}

# Cron / support
CRON_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_REQUEST_URL=

# Google Calendar / Meet integration
# Required for the shared-company Google Meet interview scheduler.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to "primary" on the shared Google account.
GOOGLE_CALENDAR_ID=primary
# Optional but recommended dedicated encryption secret for stored OAuth tokens.
CALENDAR_TOKEN_SECRET=

# OpenAI-backed features
# Required for matching, embeddings, JD AI, HR assistant, social draft, resume parsing, etc.
OPENAI_API_KEY=
# Optional: org Admin API key used ONLY by the /usage OpenAI tab (organization usage & cost endpoints).
# Set this in addition to OPENAI_API_KEY — do not remove OPENAI_API_KEY or 1:1 match and other AI features will fail.
# If unset, the Usage tab tries OPENAI_API_KEY (must have admin scope for usage APIs).
# Also accepted: OPENAI_ADMIN_API_KEY, Open_admin_AI_Key (exact Railway name), OPEN_AI_ADMIN_KEY.
OPEN_ADMIN_AI_KEY=
# If OpenAI returns org mismatch / empty usage with a multi-org account, set your org id (org-...).
# OPEN_ADMIN_USAGE_ORG=org_...
# OPENAI_ORGANIZATION_ID=org_...
OPENAI_BASE_URL=
OPENAI_MONTHLY_BUDGET=
OPENAI_MONTHLY_TOKEN_LIMIT=

# Email / notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CLIENT_RENEWAL_NOTIFY_EMAIL=

# Optional feature tuning
CAREERS_PUBLISHER_USER_ID=
NEXT_PUBLIC_MATCH_BULK_UI=
NEXT_PUBLIC_IA_V2_ENABLED=false
NEXT_PUBLIC_DASHBOARD_V2_ENABLED=false
NEXT_PUBLIC_PERSONALIZATION_V2_ENABLED=false
NEXT_PUBLIC_INTELLIGENCE_V3_ENABLED=false
NEXT_PUBLIC_AUTOMATION_V3_ENABLED=false
NEXT_PUBLIC_FORECAST_V3_ENABLED=false
NEXT_PUBLIC_CALIBRATION_V3_ENABLED=false
NEXT_PUBLIC_ORG_GOVERNANCE_V4_ENABLED=false
NEXT_PUBLIC_COMPLIANCE_V4_ENABLED=false
NEXT_PUBLIC_INTEGRATIONS_V4_ENABLED=false
NEXT_PUBLIC_SRE_HARDENING_V4_ENABLED=false
NEXT_PUBLIC_AI_GOVERNANCE_V4_ENABLED=false
AI_WORKER_CONCURRENCY=
AI_CONCURRENCY=
AI_TIMEOUT=
AI_RATE_LIMIT=
AI_RATE_LIMIT_DURATION_MS=
MATCH_DEBUG=
MATCH_AI_DISABLED=
MATCH_AI_LITE=
MATCH_VECTOR_PIPELINE=
MATCH_SHORTLIST_MIN_SCORE=
MATCH_OPENAI_MODEL=
MATCH_OPENAI_TIMEOUT_MS=
MATCH_HYBRID_RERANK_MODEL=

# Usage dashboards / provider telemetry (AI Usage → Railway tab)
# Token: Account Settings → Tokens — use an account-level token; workspace-only tokens often return "Not Authorized" on usage GraphQL.
# Do not include "Bearer " in the value; optional whitespace is trimmed server-side.
RAILWAY_API_TOKEN=
# Project Settings → General → copy Project ID (UUID)
RAILWAY_PROJECT_ID=
# Optional: scope metrics to one service / environment
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_PLAN_NAME=
RAILWAY_USAGE_LIMIT=
