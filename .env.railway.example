# Core app
NODE_ENV=production
APP_PUBLIC_URL=https://app.aasthix.com
JWT_SECRET=replace-with-a-long-random-secret
ALLOW_OPEN_SIGNUP=false

# Database / cache
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_SSL=true
REDIS_URL=${{Redis.REDIS_URL}}

# Python matcher
MATCHER_PYTHON_URL=https://your-python-matcher.up.railway.app/match

# Cron / support
CRON_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_REQUEST_URL=

# OpenAI-backed features
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MONTHLY_BUDGET=
OPENAI_MONTHLY_TOKEN_LIMIT=

# Email / notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CLIENT_RENEWAL_NOTIFY_EMAIL=

# Optional feature tuning
CAREERS_PUBLISHER_USER_ID=
NEXT_PUBLIC_MATCH_BULK_UI=
AI_WORKER_CONCURRENCY=
AI_CONCURRENCY=
AI_TIMEOUT=
AI_RATE_LIMIT=
AI_RATE_LIMIT_DURATION_MS=
MATCH_DEBUG=
MATCH_AI_DISABLED=
MATCH_AI_LITE=
MATCH_VECTOR_PIPELINE=
MATCH_SHORTLIST_MIN_SCORE=
MATCH_OPENAI_MODEL=
MATCH_OPENAI_TIMEOUT_MS=
MATCH_HYBRID_RERANK_MODEL=

# Usage dashboards / provider telemetry (AI Usage → Railway tab)
# Token: Account Settings → Tokens — use an account-level token; workspace-only tokens often return "Not Authorized" on usage GraphQL.
# Do not include "Bearer " in the value; optional whitespace is trimmed server-side.
RAILWAY_API_TOKEN=
# Project Settings → General → copy Project ID (UUID)
RAILWAY_PROJECT_ID=
# Optional: scope metrics to one service / environment
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_PLAN_NAME=
RAILWAY_USAGE_LIMIT=
